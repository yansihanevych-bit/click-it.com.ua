# ---- Public (exposed to the browser, prefix VITE_) ----
# Production origin used for canonical, hreflang, sitemap and Open Graph URLs
VITE_SITE_URL=https://click-it.com.ua

# ---- Server only (Vercel → Project Settings → Environment Variables) ----
# Contact form delivery: configure Resend and/or Telegram (at least one)
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@click-it.com.ua
CONTACT_FROM_EMAIL="Click IT website <noreply@click-it.com.ua>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated list of origins allowed to POST to /api/contact
ALLOWED_ORIGINS=https://click-it.com.ua,https://www.click-it.com.ua

# ---- Analytics ----
# Google Tag Manager container (defaults to the one already used on click-it.com.ua).
# GTM loads only on click-it.com.ua / www.click-it.com.ua. Set VITE_GTM_FORCE=true to test it on a preview URL.
VITE_GTM_ID=GTM-PCF9P2C
VITE_GTM_FORCE=
